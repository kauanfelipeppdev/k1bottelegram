TELEGRAM_TOKEN=coloque_o_token_aqui

# Destinos. Use o ID do canal/grupo (ex.: -1001234567890) ou @usuario do canal público.
# Se for um grupo com Tópicos, coloque o mesmo CHAT_ID e o ID do tópico em *_THREAD_ID.
HARDWARE_CHAT_ID=
HARDWARE_THREAD_ID=
PERIFERICOS_CHAT_ID=
PERIFERICOS_THREAD_ID=
JOGOS_GRATIS_CHAT_ID=
JOGOS_GRATIS_THREAD_ID=

# Chat da equipe (ex.: seu privado com o bot) que recebe as ofertas suspeitas
# com botões Postar/Descartar. Vazio = ofertas suspeitas são descartadas direto.

# Horas que uma oferta fica esperando análise antes de expirar
REVISAO_HORAS=2

# Intervalos de verificação (minutos)
INTERVALO_OFERTAS_MIN=5
INTERVALO_JOGOS_MIN=60

# Afiliados (deixe vazio para usar o link do Promobit)
# Amazon: seu Tracking ID, ex.: k1ofertas-20
AMAZON_TAG=
# Mercado Livre: valores de matt_tool e matt_word de um link de afiliado seu
ML_MATT_TOOL=
ML_MATT_WORD=
# AliExpress: App Key e App Secret do app em openservice.aliexpress.com
# e o Tracking ID do portals.aliexpress.com
ALI_APP_KEY=
ALI_APP_SECRET=
ALI_TRACKING_ID=

# IA para frases criativas nas ofertas (chave grátis em https://console.groq.com/keys)
# Vazio = ofertas saem sem a frase (e a checagem de repetidos fica sem o desempate da IA)
GROQ_API_KEY=
GROQ_MODELO=openai/gpt-oss-120b


# Canais públicos do Telegram para copiar ofertas (separados por vírgula)
CANAIS_FONTE=mariupromos

# Filtro de qualidade
MAX_IDADE_HORAS=24
PRECO_MINIMO=20
DESCONTO_MINIMO=10
DIAS_SEM_REPETIR=3
MAX_POR_HORA=8

# Divulgação
GRUPO_LINK=
TOP_DIA_HORA=20
